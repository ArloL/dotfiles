#!/usr/bin/env bash

set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: $0 <url>" >&2
    exit 1
fi

url="$1"

# Best quality in any codec; mkv holds them all and VLC plays it
opts=(
    --merge-output-format mkv
    --embed-metadata
    --embed-chapters
    --embed-thumbnail
    --embed-subs
    --sub-langs "en.*,de.*"
    --output "%(title)s.%(ext)s"
)

yt-dlp "${opts[@]}" "$url"
