#!/bin/sh

set -o errexit
set -o nounset
set -o xtrace

sleep 33

cd ~/.dotfiles
git pull --rebase
git push origin main

# Homebrew
if hash brew 2>/dev/null; then
    brew update
    # tapped formulae print as tap/name; services list uses name
    outdated=$(brew outdated --formula --quiet | sed 's|.*/||')
    # quitting these mid-use loses work
    HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
        brew upgrade --no-ask
    # brew upgrade leaves running services on the old binary
    for service in $(brew services list | awk '$2 == "started" { print $1 }'); do
        if echo "$outdated" | grep -qx "$service"; then
            brew services restart "$service"
        fi
    done
    brew autoremove
    brew cleanup
fi

# mise
if hash mise 2>/dev/null; then
    # ruby's configure runs `ruby`; with auto-install the shim would recurse into installing the same ruby
    MISE_NOT_FOUND_AUTO_INSTALL=false mise install
    mise prune --yes
fi

# gem
if hash gem 2>/dev/null; then
    gem update
fi

# docker
if hash podman 2>/dev/null; then
    container=podman
elif hash docker 2>/dev/null; then
    container=docker
fi
if [ -n "${container:-}" ] && "$container" info >/dev/null; then
    "$container" system prune --filter "until=240h" --force
    "$container" volume prune --force
fi

if hash direnv 2>/dev/null; then
    direnv prune
fi
