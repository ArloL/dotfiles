{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "addLabels": [
        "{{manager}}",
    ],
    "extends": [
        "config:recommended",
        "customManagers:githubActionsVersions",
    ],
    "labels": [
        "dependencies",
    ],
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "matchManagers": [
                "mise",
            ],
            "matchPackageNames": [
                "/^arlol\\//i",
            ],
            "minimumReleaseAge": "0 days",
            "schedule": [
                "at any time",
            ],
            "automerge": true,
        },
    ],
    "prConcurrentLimit": 10,
    "prHourlyLimit": 5,
    "schedule": [
        "* * 20-23 * *",
    ],
    "vulnerabilityAlerts": {
        "addLabels": [
            "security",
        ],
        "minimumReleaseAge": "0 days",
        "schedule": [
            "at any time",
        ],
    },
}
